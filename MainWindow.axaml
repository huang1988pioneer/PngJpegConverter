<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PngToJpegConverter.MainWindow"
        Title="PNG 轉 JPEG 批次轉換器"
        Width="900"
        Height="680"
        MinWidth="760"
        MinHeight="600"
        Background="#F6F7F9"
        CanResize="True">
  <Grid RowDefinitions="Auto,*" Margin="28" RowSpacing="22">
    <StackPanel Spacing="6">
      <TextBlock Text="PNG 轉 JPEG 批次轉換器"
                 FontSize="28"
                 FontWeight="SemiBold"
                 Foreground="#171A1F" />
      <TextBlock Text="多選 PNG 檔案、選擇資料夾，或輸入圖片網址後轉換成 JPEG。"
                 FontSize="14"
                 Foreground="#626B79" />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="3*,2*" ColumnSpacing="22">
      <Border Background="White"
              BorderBrush="#D8DDE5"
              BorderThickness="1"
              CornerRadius="8"
              Padding="18">
        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">
          <StackPanel Spacing="10">
            <TextBlock Text="來源"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="#252A32" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
              <Button x:Name="ChooseFilesButton"
                      Content="選擇 PNG 檔案"
                      HorizontalAlignment="Stretch"
                      Height="38"
                      Click="ChooseFilesButton_Click" />
              <Button x:Name="ChooseInputFolderButton"
                      Grid.Column="1"
                      Content="選擇輸入資料夾"
                      HorizontalAlignment="Stretch"
                      Height="38"
                      Click="ChooseInputFolderButton_Click" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <TextBox x:Name="ImageUrlTextBox"
                       Watermark="輸入圖片網址，例如 https://example.com/image.png"
                       Height="38"
                       VerticalContentAlignment="Center"
                       KeyDown="ImageUrlTextBox_KeyDown" />
              <Button x:Name="AddUrlButton"
                      Grid.Column="1"
                      Content="加入網址"
                      Width="96"
                      Height="38"
                      Click="AddUrlButton_Click" />
            </Grid>
            <CheckBox x:Name="IncludeSubfoldersCheckBox"
                      Content="包含子資料夾"
                      IsChecked="True"
                      Foreground="#252A32" />
          </StackPanel>

          <StackPanel Grid.Row="1" Spacing="8">
            <TextBlock x:Name="SourceSummaryText"
                       Text="尚未選擇檔案、資料夾或網址"
                       TextWrapping="Wrap"
                       Foreground="#626B79" />
            <TextBlock x:Name="InputFolderText"
                       Text=""
                       TextWrapping="Wrap"
                       Foreground="#626B79" />
          </StackPanel>

          <Border Grid.Row="2"
                  Background="#FAFBFC"
                  BorderBrush="#E2E6ED"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="10">
            <ListBox x:Name="SelectedFilesList"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="#252A32" />
          </Border>

          <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="8">
              <TextBlock Text="JPEG 品質"
                         FontWeight="SemiBold"
                         Foreground="#252A32" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <Slider x:Name="QualitySlider"
                        Minimum="1"
                        Maximum="100"
                        Value="90"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        PropertyChanged="QualitySlider_PropertyChanged" />
                <TextBlock x:Name="QualityText"
                           Grid.Column="1"
                           Text="90%"
                           Width="44"
                           VerticalAlignment="Center"
                           TextAlignment="Right"
                           Foreground="#252A32" />
              </Grid>
            </StackPanel>
            <Button x:Name="ClearButton"
                    Grid.Column="1"
                    Content="清除"
                    Width="82"
                    Height="38"
                    VerticalAlignment="Bottom"
                    Click="ClearButton_Click" />
          </Grid>
        </Grid>
      </Border>

      <Border Grid.Column="1"
              Background="White"
              BorderBrush="#D8DDE5"
              BorderThickness="1"
              CornerRadius="8"
              Padding="22">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="18">
          <StackPanel Spacing="10">
            <TextBlock Text="輸出"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#252A32" />
            <Button x:Name="ChooseOutputFolderButton"
                    Content="選擇輸出資料夾"
                    Height="38"
                    HorizontalAlignment="Stretch"
                    Click="ChooseOutputFolderButton_Click" />
            <TextBlock x:Name="OutputFolderText"
                       Text="未選擇時會輸出到每個本機 PNG 的原資料夾；網址圖片會輸出到程式資料夾"
                       TextWrapping="Wrap"
                       Foreground="#626B79" />
          </StackPanel>

          <StackPanel Grid.Row="1"
                      VerticalAlignment="Center"
                      Spacing="12">
            <Border Background="#FAFBFC"
                    BorderBrush="#E2E6ED"
                    BorderThickness="1"
                    CornerRadius="8"
                    Height="230"
                    Padding="12">
              <Image x:Name="PreviewImage"
                     Stretch="Uniform" />
            </Border>
            <TextBlock x:Name="ImageInfoText"
                       Text="等待選取圖片"
                       FontSize="15"
                       FontWeight="SemiBold"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="#252A32" />
            <TextBlock x:Name="StatusText"
                       Text=""
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Foreground="#1F7A4D" />
          </StackPanel>

          <Button x:Name="ConvertButton"
                  Grid.Row="2"
                  Content="全部轉換成 JPEG"
                  Height="42"
                  HorizontalAlignment="Stretch"
                  IsEnabled="False"
                  Click="ConvertButton_Click" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
